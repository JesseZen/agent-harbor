diff --git a/src/app/api/primary_selection.rs b/src/app/api/primary_selection.rs
new file mode 100644
index 0000000..9efe787
--- /dev/null
+++ b/src/app/api/primary_selection.rs
@@ -0,0 +1,108 @@
+use crate::api::schema::{PaneReportPrimarySelectionParams, ResponseResult};
+use crate::app::App;
+
+use super::responses::{encode_error, encode_success};
+
+impl App {
+    pub(super) fn handle_pane_report_primary_selection(
+        &mut self,
+        id: String,
+        params: PaneReportPrimarySelectionParams,
+    ) -> String {
+        let result = self.accept_primary_selection(&params);
+        match result {
+            Ok(()) => encode_success(id, ResponseResult::Ok {}),
+            Err(message) => encode_error(id, "primary_selection_not_accepted", message),
+        }
+    }
+
+    #[cfg(not(unix))]
+    fn accept_primary_selection(
+        &mut self,
+        _params: &PaneReportPrimarySelectionParams,
+    ) -> Result<(), &'static str> {
+        Err("local primary selection is unavailable")
+    }
+
+    #[cfg(unix)]
+    fn accept_primary_selection(
+        &mut self,
+        params: &PaneReportPrimarySelectionParams,
+    ) -> Result<(), &'static str> {
+        let Some(pid) = params.verified_peer_pid.filter(|pid| *pid > 1) else {
+            return Err("local foreground process required");
+        };
+        if params.reason != "resume"
+            || params.sequence == 0
+            || params.run_token.len() != 48
+            || !params
+                .run_token
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit())
+            || params.previous_id.len() != 36
+            || params.selected_id.len() != 36
+        {
+            return Err("invalid primary selection report");
+        }
+        let Some((workspace, pane)) = self.parse_pane_id(&params.pane_id) else {
+            return Err("foreground pane is unavailable");
+        };
+        let foreground = self
+            .lookup_runtime(workspace, pane)
+            .and_then(|(runtime, _)| runtime.child_pid())
+            .and_then(crate::detect::foreground_process_group_id);
+        if foreground != Some(pid) {
+            return Err("reporter does not own the pane's foreground process group");
+        }
+        let config = crate::config::config_dir();
+        let Some(workspace_config) = config.parent() else {
+            return Err("primary selection observer is unavailable");
+        };
+        let observer = workspace_config.join(format!(".as-{}", &params.run_token[..24]));
+        let report = serde_json::json!({
+            "source": "herdr:codex-primary-selection-v1",
+            "reason": params.reason,
+            "sequence": params.sequence,
+            "previous_id": params.previous_id,
+            "selected_id": params.selected_id,
+            "run_token": params.run_token,
+            "pane_id": params.pane_id,
+            "pid": pid,
+        });
+        forward_selection(&observer, &report)
+            .map_err(|_| "workspace did not durably accept this selection")?;
+        let seq = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .ok()
+            .and_then(|duration| u64::try_from(duration.as_nanos()).ok());
+        self.handle_internal_event(crate::events::AppEvent::AgentSessionReported {
+            pane_id: pane,
+            source: "herdr:codex".into(),
+            agent_label: "codex".into(),
+            session_ref: crate::agent_resume::AgentSessionRef::id(params.selected_id.clone()),
+            seq,
+            session_start_source: Some("resume".into()),
+        });
+        Ok(())
+    }
+}
+
+#[cfg(unix)]
+fn forward_selection(path: &std::path::Path, report: &serde_json::Value) -> std::io::Result<()> {
+    use std::io::{Read as _, Write as _};
+    use std::os::unix::net::UnixStream;
+    use std::time::Duration;
+
+    let mut connection = UnixStream::connect(path)?;
+    let timeout = Some(Duration::from_secs(1));
+    connection.set_read_timeout(timeout)?;
+    connection.set_write_timeout(timeout)?;
+    serde_json::to_writer(&mut connection, report)?;
+    connection.write_all(b"\n")?;
+    let mut reply = [0; 9];
+    connection.read_exact(&mut reply)?;
+    if &reply != b"accepted\n" {
+        return Err(std::io::Error::other("selection rejected"));
+    }
+    Ok(())
+}
