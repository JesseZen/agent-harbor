index 0000000..a53066c
--- /dev/null
+++ b/internal/gateway/codex_catalog_lite_test.go
@@ -0,0 +1,74 @@
+package gateway
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func TestHarborResponsesLiteCatalogs(t *testing.T) {
+	fresh(t)
+	t.Setenv("MAGPIE_CODEX_CALLER_ONLY", "1")
+	chatgpt(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Query().Has("responses_format") {
+			t.Error("Harbor format reached the official catalog")
+		}
+		io.WriteString(w, `{"models":[{"slug":"gpt-official","priority":1,"use_responses_lite":true}]}`)
+	})
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.WriteString(w, `{"data":[{"id":"gpt-6.2-sol"},{"id":"another-model"}]}`)
+	}))
+	defer upstream.Close()
+	relay := provider.Provider{
+		ID: "aihub", Responses: upstream.URL + "/v1",
+		Key: "fixture", Models: []string{"gpt-6.2-sol", "another-model"}, CodexAsSent: true,
+	}
+	if err := provider.Save(relay); err != nil {
+		t.Fatal(err)
+	}
+	handler := lanGuard(New().Handler())
+	check := func(path string, liteRequested, wantLite bool) {
+		t.Helper()
+		requestURL := path + "?client_version=0.172.0"
+		if liteRequested && path != harborCodexLitePath+"/models" {
+			requestURL += "&responses_format=lite"
+		}
+		w := keysCall(handler, "GET", requestURL, fromHere, "client-oauth", "", "chatgpt-account-id", "client-account")
+		var list struct {
+			Format string `json:"magpie_responses_format"`
+			Models []struct {
+				Slug string `json:"slug"`
+				Lite bool   `json:"use_responses_lite"`
+			} `json:"models"`
+		}
+		if w.Code != http.StatusOK || json.Unmarshal(w.Body.Bytes(), &list) != nil {
+			t.Fatalf("%s got HTTP %d or invalid JSON", requestURL, w.Code)
+		}
+		got := map[string]bool{}
+		for _, model := range list.Models {
+			got[model.Slug] = model.Lite
+		}
+		if advertised, found := got["aihub/gpt-6.2-sol"]; !found || advertised != wantLite || got["aihub/another-model"] {
+			t.Errorf("%s models %+v, want aihub Lite=%v", requestURL, got, wantLite)
+		}
+		if (list.Format == "lite") != liteRequested || (path != CodexCatalogPath && !got["gpt-official"]) {
+			t.Errorf("%s format %q, models %+v", requestURL, list.Format, got)
+		}
+	}
+	for _, path := range []string{CodexCatalogPath, CodexPath + "/models"} {
+		check(path, false, false)
+		check(path, true, true)
+	}
+	check(harborCodexLitePath+"/models", true, true)
+	relay.CodexAsSent = false
+	if err := provider.Save(relay); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{CodexCatalogPath, CodexPath + "/models"} {
+		check(path, true, false)
+	}
+}
