+package gateway
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func TestHarborResponsesLiteNativeJoined(t *testing.T) {
+	native := os.Getenv("HARBOR_TEST_CODEX_BIN")
+	if native == "" {
+		t.Skip("set HARBOR_TEST_CODEX_BIN to test a real Codex client")
+	}
+	fresh(t)
+	codexChatGPTAuth(t, "harbor-fixture@example.com")
+	t.Setenv("MAGPIE_CODEX_CALLER_ONLY", "1")
+	var officialLists, liteTurns atomic.Int32
+	chatgpt(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == CodexPath+"/models" && r.Header.Get("chatgpt-account-id") == "acct-synthetic" {
+			officialLists.Add(1)
+			w.Header().Set("Content-Type", "application/json")
+			io.WriteString(w, `{"models":[]}`)
+			return
+		}
+		http.NotFound(w, r)
+	})
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodGet {
+			io.WriteString(w, `{"data":[{"id":"gpt-6.2-sol"}]}`)
+			return
+		}
+		if r.Header.Get("Authorization") != "Bearer provider-fixture" {
+			t.Error("upstream did not receive its provider credential")
+		}
+		if r.Header.Get("X-Openai-Internal-Codex-Responses-Lite") != "true" {
+			t.Error("upstream did not receive the Lite header")
+		}
+		liteTurns.Add(1)
+		const message = `{"id":"msg_test","type":"message","status":"completed","role":"assistant","content":[{"type":"output_text","text":"HARBOR_JOINED_LITE_OK","annotations":[]}]}`
+		w.Header().Set("Content-Type", "text/event-stream")
+		for _, event := range []string{
+			`{"type":"response.created","response":{"id":"resp_test","object":"response","status":"in_progress","output":[]}}`,
+			`{"type":"response.output_item.done","output_index":0,"item":` + message + `}`,
+			`{"type":"response.completed","response":{"id":"resp_test","object":"response","status":"completed","output":[` + message + `],"usage":{"input_tokens":10,"output_tokens":5,"total_tokens":15}}}`,
+		} {
+			fmt.Fprintf(w, "data: %s\n\n", event)
+		}
+	}))
+	defer upstream.Close()
+	if err := provider.Save(provider.Provider{ID: "aihub", Responses: upstream.URL + "/v1", Key: "provider-fixture",
+		Models: []string{"gpt-6.2-sol"}, CodexAsSent: true}); err != nil {
+		t.Fatal(err)
+	}
+	gateway := httptest.NewServer(New().Front())
+	defer gateway.Close()
+	root, home := t.TempDir(), os.Getenv("CODEX_HOME")
+	if err := os.WriteFile(filepath.Join(home, "config.toml"), []byte("check_for_update_on_startup = false\ncli_auth_credentials_store = \"file\"\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 22*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, native, "exec", "--ephemeral", "--skip-git-repo-check", "--disable", "apps",
+		"-m", provider.HarborResponsesLiteModel, "-c", `openai_base_url="`+gateway.URL+harborCodexLitePath+`"`, "Say hello")
+	cmd.Dir = root
+	cmd.Env = []string{"PATH=/usr/bin:/bin", "HOME=" + root, "CODEX_HOME=" + home, "XDG_CONFIG_HOME=" + root,
+		"XDG_CACHE_HOME=" + root, "TERM=dumb", "LANG=C.UTF-8", "HTTP_PROXY=http://127.0.0.1:9",
+		"HTTPS_PROXY=http://127.0.0.1:9", "ALL_PROXY=http://127.0.0.1:9", "NO_PROXY=127.0.0.1,localhost"}
+	out, err := cmd.CombinedOutput()
+	if err != nil || !strings.Contains(string(out), "HARBOR_JOINED_LITE_OK") || officialLists.Load() == 0 || liteTurns.Load() == 0 {
+		t.Fatalf("real Codex failed: %v; official lists %d, Lite turns %d\n%s", err, officialLists.Load(), liteTurns.Load(), out)
+	}
+}
